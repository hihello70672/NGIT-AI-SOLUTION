# Local PostgreSQL Compose configuration. Generate unique local values before use.
POSTGRES_DB=ngit
POSTGRES_USER=ngit
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_PORT=5432

# Separate local app login. Review actual runtime/migration grants before use.
NGIT_APP_USER=ngit_app
NGIT_APP_PASSWORD=replace-with-a-unique-local-app-password

# Host API configuration; keep aligned with the local database service.
POSTGRES_HOST=localhost
DATABASE_SCHEMA=ngit
DATABASE_URL=postgresql://ngit:replace-with-a-unique-local-password@localhost:5432/ngit
APP_DATABASE_URL=postgresql://ngit_app:replace-with-a-unique-local-app-password@localhost:5432/ngit

# Generate unique local values; these are examples, not deployable secrets.
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes-before-use
PASSWORD_PEPPER=replace-with-at-least-16-random-bytes-before-use
