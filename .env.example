# Local development database only. Replace outside local development.
POSTGRES_DB=ngit
POSTGRES_USER=ngit
POSTGRES_PASSWORD=ngit_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set a unique random value of at least 32 bytes before starting the API.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No real secret is included in this example file.
AUTH_TOKEN_PEPPER=
