# Local development database only. Replace outside local development.
POSTGRES_DB=ngit
POSTGRES_USER=ngit
POSTGRES_PASSWORD=ngit_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set a unique random value of at least 32 bytes before starting the API.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No real secret is included in this example file.
AUTH_TOKEN_PEPPER=
# Optional password pepper; configure before account creation and keep stable.
PASSWORD_PEPPER=
# Optional: comma-separated browser origins for API access.
CORS_ORIGINS=
# Optional overrides:
# DATABASE_URL=postgresql://ngit:local-password@localhost:5432/ngit
# DATABASE_SCHEMA=ngit

# Optional local or self-hosted OpenAI-compatible chat endpoint.
# Example local endpoint root: http://localhost:11434/v1 (Ollama-compatible).
NGIT_LOCAL_MODEL_BASE_URL=
NGIT_LOCAL_MODEL_ID=local-default
NGIT_LOCAL_MODEL_NAME=local-model
NGIT_LOCAL_MODEL_API_KEY=
# Optional second self-hosted endpoint, attempted only when fallback is enabled.
NGIT_SELF_HOSTED_MODEL_BASE_URL=
NGIT_SELF_HOSTED_MODEL_ID=self-hosted-fallback
NGIT_SELF_HOSTED_MODEL_NAME=self-hosted-model
NGIT_SELF_HOSTED_MODEL_API_KEY=
