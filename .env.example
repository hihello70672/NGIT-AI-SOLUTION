# Local PostgreSQL Compose configuration. Replace example credentials locally.
POSTGRES_DB=ngit
POSTGRES_USER=ngit
POSTGRES_PASSWORD=ngit_local_only
POSTGRES_PORT=5432

# API database connection (Compose publishes PostgreSQL on localhost).
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5432
DATABASE_SCHEMA=ngit

# Required by API configuration. Generate unique random values for local use.
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes-before-use
PASSWORD_PEPPER=replace-with-at-least-16-random-bytes-before-use

# Optional local/self-hosted Brain runtimes. Empty endpoints disable generation.
NGIT_LOCAL_MODEL_BASE_URL=
NGIT_LOCAL_MODEL_ID=local-default
NGIT_LOCAL_MODEL_NAME=local-model
NGIT_LOCAL_MODEL_API_KEY=
NGIT_SELF_HOSTED_MODEL_BASE_URL=
NGIT_SELF_HOSTED_MODEL_ID=self-hosted-fallback
NGIT_SELF_HOSTED_MODEL_NAME=self-hosted-model
NGIT_SELF_HOSTED_MODEL_API_KEY=

# Comma-separated exact approved source origins; empty disables ingestion.
NGIT_KNOWLEDGE_SOURCE_ALLOWLIST=

# Optional isolated workspace for local Agent filesystem tools.
NGIT_AGENT_WORKSPACE=
