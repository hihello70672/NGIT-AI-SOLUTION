# Local PostgreSQL Compose settings. Change the example password before use.
POSTGRES_DB=ngit
POSTGRES_USER=ngit
POSTGRES_PASSWORD=ngit_local_only
POSTGRES_PORT=5432

# API database configuration (the API connects to the published localhost port).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_SCHEMA=ngit

# Required by API startup. Generate unique random values locally; these examples are not secrets.
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes-before-use
PASSWORD_PEPPER=replace-with-at-least-16-random-bytes-before-use

# Optional local/self-hosted Brain runtime. Empty endpoint URLs keep generation disabled.
NGIT_LOCAL_MODEL_BASE_URL=
NGIT_LOCAL_MODEL_ID=local-default
NGIT_LOCAL_MODEL_NAME=local-model
NGIT_LOCAL_MODEL_API_KEY=
NGIT_SELF_HOSTED_MODEL_BASE_URL=
NGIT_SELF_HOSTED_MODEL_ID=self-hosted-fallback
NGIT_SELF_HOSTED_MODEL_NAME=self-hosted-model
NGIT_SELF_HOSTED_MODEL_API_KEY=

# Comma-separated exact approved identifier/URL origins; empty disables ingestion.
NGIT_KNOWLEDGE_SOURCE_ALLOWLIST=

# Optional isolated agent workspace.
NGIT_AGENT_WORKSPACE=
